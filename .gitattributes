# Content-addressed notices and their upstream sources must retain exact bytes on checkout.
docs/licenses/** linguist-vendored -text
# The generated aggregate retains the exact whitespace of upstream notices.
docs/licenses/THIRD_PARTY_LICENSES.txt -whitespace
docs/licenses/upstream/objc2-*/** -text
crates/providers/assets/** linguist-vendored
# Runtime SHA-256 validation requires exact upstream bytes on Windows too.
crates/providers/assets/openai-models.json -text
workers/image3d/image3d_adapter.py -text
workers/image3d/runtime-lock*.json -text
workers/image3d/licenses/** -text
*.png binary
*.glb binary
*.blend binary
*.crate binary
# Keep the npm distribution identical across Windows and Mac checkouts.
integrations/npm/** text eol=lf
scripts/prepare-skill-npm.mjs text eol=lf
scripts/verify-skill-npm-package.mjs text eol=lf
tests/npm-skill/** text eol=lf
